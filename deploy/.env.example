# Dev defaults. Copy to deploy/.env via `make init`. Never commit deploy/.env.
POSTGRES_PASSWORD=postgres_dev
APP_USER_PASSWORD=app_user_dev
MIGRATOR_PASSWORD=app_migrator_dev
RELAY_USER_PASSWORD=relay_user_dev
ML_WORKER_PASSWORD=ml_worker_dev
# Service token protecting the pyworker's internal /score endpoint. CHANGE in production.
PYWORKER_SERVICE_TOKEN=dev-pyworker-token-change-me
FERRISKEY_PASSWORD=ferriskey_dev
ENV=development
# HMAC key for pagination cursors; required when ENV=production.
CURSOR_SECRET=
# OIDC (profile "oidc"): see README. Leave empty for dev header auth.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# FerrisKey (OIDC). The default admin/admin is overridden: CHANGE these in production.
FERRISKEY_ADMIN_USER=ratify-admin
FERRISKEY_ADMIN_PASSWORD=dev-ferriskey-admin-change-me
FERRISKEY_ADMIN_EMAIL=admin@ratify.test
# Web app (Auth.js). Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789abcdef
OIDC_CLIENT_SECRET=
